# Copy to .env.local and fill in. Anything that should be exposed to the browser
# must start with NEXT_PUBLIC_. Everything else is server-only.

# --- App ---
APP_URL=http://localhost:3000
# Service WhatsApp phone (digits only, E.164 without +). Browser-readable.
NEXT_PUBLIC_SERVICE_PHONE=
# Random hex string. Vercel sends it as Bearer header on cron invocations.
CRON_SECRET=

# --- Supabase (added in build step 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPlus (build step 1) ---
# Live: https://restapi.payplus.co.il/api/v1.0  Sandbox: https://restapidev.payplus.co.il/api/v1.0
PAYPLUS_BASE_URL=https://restapidev.payplus.co.il/api/v1.0
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
# UID of the Payment Page configured in the PayPlus dashboard.
PAYPLUS_PAYMENT_PAGE_UID=
# Used to verify HMAC on the IPN callback. Configure same value in PayPlus dashboard.
PAYPLUS_HMAC_SECRET=

# --- WhatsApp: Green API (MVP, build step 4) ---
# Base URLs are per-instance; copy from the Green API dashboard.
GREEN_API_BASE_URL=
GREEN_API_MEDIA_URL=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_SECRET=

# --- WhatsApp: Meta Cloud API (post-MVP migration; leave empty for now) ---
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# --- Printful (build step 5) ---
PRINTFUL_PRIVATE_TOKEN=
# Required when the token owns multiple stores. Find via GET /v2/stores.
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=

# --- Prodigi (Printful replacement for IL shipping) ---
# Sandbox: https://api.sandbox.prodigi.com/v4.0  Live: https://api.prodigi.com/v4.0
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0
PRODIGI_API_KEY=
# Random hex string. Bake into the callback URL in Prodigi dashboard:
#   https://www.wallaura.art/api/webhooks/prodigi?secret=<value>
PRODIGI_WEBHOOK_SECRET=

# --- Resend (build step 6) ---
RESEND_API_KEY=
# Default uses Resend's onboarding@ sender. After verifying wallaura.art in
# the Resend dashboard, set this to e.g. "Wallaura <orders@wallaura.art>".
RESEND_FROM=

# --- Slack notifications ---
# Incoming Webhook URL from https://api.slack.com/apps. Posts events
# (phone entered, photo uploaded, checkout started, payment completed).
SLACK_WEBHOOK_URL=
